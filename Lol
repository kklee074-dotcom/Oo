-- ปุ่มฟังก์ชันหลัก: Auto Prompt สล็อต
local Btn1 = Instance.new("TextButton")
Btn1.Parent = MainFrame
Btn1.BackgroundColor3 = Color3.fromRGB(46, 204, 113)
Btn1.Position = UDim2.new(0.1, 0, 0.22, 0)
Btn1.Size = UDim2.new(0.8, 0, 0, 35)
Btn1.Font = Enum.Font.SourceSansBold
Btn1.Text = "เปิด Auto Prompt (สล็อต)"
Btn1.TextColor3 = Color3.fromRGB(255, 255, 255)
Btn1.TextSize = 13
Instance.new("UICorner", Btn1).CornerRadius = UDim.new(0, 6)

local isAutoRunning = false
Btn1.MouseButton1Click:Connect(function()
    isAutoRunning = not isAutoRunning
    if isAutoRunning then
        Btn1.Text = "สถานะ: เปิด Auto Prompt"
        task.spawn(function()
            while isAutoRunning do
                pcall(function()
                    for _, plot in pairs(Workspace.Plots:GetChildren()) do
                        for _, expansion in pairs(plot:GetChildren()) do
                            if expansion.Name:match("Expansion") then
                                for _, slot in pairs(expansion:GetChildren()) do
                                    if slot:FindFirstChild("PromptAttachment") then
                                        local prompt = slot.PromptAttachment:FindFirstChild("ProximityPrompt")
                                        if prompt and prompt.Enabled then
                                            fireproximityprompt(prompt)
                                        end
                                    end
                                end
                            end
                        end
                    end
                end)
                task.wait(1.5)
            end
        end)
    else
        Btn1.Text = "เปิด Auto Prompt (สล็อต)"
    end
end)

