local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local VirtualUser = game:GetService("VirtualUser")
local CoreGui = game:GetService("CoreGui")

local player = Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()

local autoStealActive = false
local autoCollectMoneyActive = false
local autoUnlockPlotActive = false
local customWalkSpeed = 20 -- ความเร็วเดินเริ่มต้น

player.Idled:Connect(function()
    VirtualUser:CaptureController()
    VirtualUser:ClickButton2(Vector2.new())
end)

RunService.Stepped:Connect(function()
    if character and character:FindFirstChild("Humanoid") then
        if autoStealActive then
            for _, part in pairs(character:GetDescendants()) do
                if part:IsA("BasePart") and part.CanCollide then
                    part.CanCollide = false
                end
            end
        end
        -- ล็อกปรับความเร็วตามที่ตั้งไว้
        character.Humanoid.WalkSpeed = customWalkSpeed
    end
end)

local function interact(obj)
    if obj:IsA("ProximityPrompt") then
        fireproximityprompt(obj)
    elseif obj:IsA("ClickDetector") then
        fireclickdetector(obj)
    end
end

-- ฟังก์ชันหาบ้านของเรา
local function getMyPlot()
    for _, plot in pairs(workspace:GetChildren()) do
        if string.find(string.lower(plot.Name), "plot") then
            if string.find(plot.Name, player.Name) then
                return plot
            end
            for _, desc in pairs(plot:GetDescendants()) do
                if desc.Name == player.Name or (desc:IsA("StringValue") and desc.Value == player.Name) then
                    return plot
                end
            end
        end
    end
    return nil
end

-- ระบบเก็บเงินออโต้
local function doAutoCollectMoney()
    while autoCollectMoneyActive do
        character = player.Character or player.CharacterAdded:Wait()
        local root = character:FindFirstChild("HumanoidRootPart")
        local myPlot = getMyPlot()
        
        if root and firetouchinterest and myPlot then
            for _, obj in pairs(myPlot:GetDescendants()) do
                if obj:IsA("BasePart") and (obj.Name == "AutoCollect" or obj.Name == "Touch" or string.find(string.lower(obj.Name), "money")) then
                    firetouchinterest(root, obj, 0)
                    task.wait(0.05)
                    firetouchinterest(root, obj, 1)
                end
            end
        end
        task.wait(2)
    end
end

-- ระบบปลดล็อคฐานออโต้
local function doAutoUnlockPlot()
    while autoUnlockPlotActive do
        pcall(function()
            character = player.Character or player.CharacterAdded:Wait()
            local root = character:FindFirstChild("HumanoidRootPart")
            local myPlot = getMyPlot()
            
            local leaderstats = player:FindFirstChild("leaderstats")
            local playerMoney = 0
            if leaderstats then
                local cash = leaderstats:FindFirstChild("Cash") or leaderstats:FindFirstChild("Money") or leaderstats:FindFirstChild("Coins")
                if cash then playerMoney = cash.Value end
            end
            
            if root and myPlot and firetouchinterest then
                for _, obj in pairs(myPlot:GetDescendants()) do
                    if not autoUnlockPlotActive then break end
                    
                    if obj:IsA("BasePart") and (string.find(string.lower(obj.Name), "button") or string.find(string.lower(obj.Name), "unlock") or string.find(string.lower(obj.Name), "buy") or obj.Name == "Touch") then
                        local cost = obj:GetAttribute("Cost") or obj:GetAttribute("Price")
                        if not cost and obj.Parent then
                            cost = obj.Parent:GetAttribute("Cost") or obj.Parent:GetAttribute("Price")
                        end
                        
                        if cost and playerMoney < cost then
                            continue
                        end
                        
                        local originalCFrame = root.CFrame
                        root.CFrame = obj.CFrame + Vector3.new(0, 2, 0)
                        task.wait(0.05)
                        firetouchinterest(root, obj, 0)
                        task.wait(0.05)
                        firetouchinterest(root, obj, 1)
                        task.wait(0.1)
                        root.CFrame = originalCFrame
                        task.wait(0.5)
                    end
                end
            end
        end)
        task.wait(3)
    end
end

-- ระบบ Instant Steal (กวาดไอเทมจุดสาธารณะแบบเสถียร)
local function doAutoSteal()
    while autoStealActive do
        character = player.Character or player.CharacterAdded:Wait()
        local root = character:FindFirstChild("HumanoidRootPart")
        local myPlot = getMyPlot()
        
        if root then
            for _, obj in pairs(workspace:GetDescendants()) do
                if not autoStealActive then break end
                
                if obj:IsA("ProximityPrompt") or obj:IsA("ClickDetector") then
                    local parentPart = obj.Parent
                    if parentPart and (parentPart:IsA("BasePart") or parentPart:IsA("Model")) then
                        
                        -- เช็กไม่ให้ยุ่งกับบ้านตัวเอง
                        local isInsideMyPlot = false
                        if myPlot and parentPart:IsDescendantOf(myPlot) then
                            isInsideMyPlot = true
                        end
                        
                        if not isInsideMyPlot then
                            local originalCFrame = root.CFrame
                            local targetCF = parentPart:IsA("Model") and parentPart:GetPivot() or parentPart.CFrame
                            
                            root.CFrame = targetCF + Vector3.new(0, 2, 0)
                            task.wait(0.05)
                            
                            for i = 1, 4 do
                                interact(obj)
                                task.wait(0.05)
                            end
                            
                            root.CFrame = originalCFrame
                            task.wait(0.1)
                        end
                    end
                end
            end
        end
        task.wait(0.3)
    end
end

