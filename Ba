-- ระบบขโมยการ์ด (ทำงานเมื่อกดปุ่มวงกลมลอย)
local isStealingRunning = false
CircleToggleBtn.MouseButton1Click:Connect(function()
    isStealingRunning = not isStealingRunning
    if isStealingRunning then
        CircleToggleBtn.BackgroundColor3 = Color3.fromRGB(46, 204, 113) -- เปลี่ยนเป็นสีเขียวเมื่อเปิด
        StatusLabel.Text = "สถานะ: กำลังขโมยการ์ด (เปิด)"
        StatusLabel.TextColor3 = Color3.fromRGB(46, 204, 113)
        
        task.spawn(function()
            while isStealingRunning do
                pcall(function()
                    local basePos = nil
                    for _, plot in pairs(Workspace.Plots:GetChildren()) do
                        if plot:FindFirstChild("Base") and plot:GetAttribute("PlotOwner") == LocalPlayer.UserId then
                            basePos = plot.Base.CFrame + Vector3.new(0, 5, 0)
                            break
                        end
                    end
                    
                    local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                    if hrp and basePos then
                        local targetFilter = rarities[currentRarityIndex]
                        local collected = false
                        
                        for _, obj in pairs(Workspace:GetDescendants()) do
                            if not isStealingRunning then break end
                            if obj:IsA("ProximityPrompt") then
                                -- ป้องกันไม่ให้ไปโดนปุ่ม Robux หรือ Pass
                                local actionText = string.lower(obj.ActionText or "")
                                local objectText = string.lower(obj.ObjectText or "")
                                local parentName = string.lower(obj.Parent and obj.Parent.Name or "")
                                
                                local isRobuxPrompt = (actionText:find("buy") or actionText:find("pass") or actionText:find("robux") or 
                                                       objectText:find("buy") or objectText:find("pass") or objectText:find("robux") or
                                                       parentName:find("pass") or parentName:find("gamepass"))
                                
                                if not isRobuxPrompt then
                                    local parentModel = obj.Parent and obj.Parent.Parent
                                    local match = true
                                    
                                    if not targetFilter:find("All") then
                                        match = false
                                        if parentModel then
                                            local rAttr = parentModel:GetAttribute("Rarity") or parentModel:GetAttribute("Mutation") or ""
                                            if tostring(rAttr):lower():find(targetFilter:lower()) or parentModel.Name:lower():find(targetFilter:lower()) then
                                                match = true
                                            end
                                        end
                                    end
                                    
                                    if match then
                                        local targetPart = obj.Parent
                                        if targetPart and targetPart:IsA("BasePart") then
                                            -- 1. วาร์ปไปหาการ์ด
                                            hrp.CFrame = targetPart.CFrame + Vector3.new(0, 3, 0)
                                            task.wait(0.2)
                                            -- 2. กดเก็บ
                                            fireproximityprompt(obj)
                                            task.wait(0.2)
                                            -- 3. วาร์ปกลับฐานทันที
                                            hrp.CFrame = basePos
                                            collected = true
                                            task.wait(0.5)
                                            break
                                        end
                                    end
                                end
                            end
                        end
                        
                        if not collected then
                            task.wait(1)
                        end
                    end
                end)
                task.wait(0.3)
            end
        end)
    else
        CircleToggleBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 30) -- เปลี่ยนกลับเป็นสีดำเมื่อปิด
        StatusLabel.Text = "สถานะ: ปิดการทำงาน"
        StatusLabel.TextColor3 = Color3.fromRGB(180, 180, 180)
    end
end)
