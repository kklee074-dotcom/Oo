-- ปุ่มเลือกความหายาก / กลายพันธุ์ (Rarity Filter)
local rarities = {"All (ทั้งหมด)", "Legendary", "Epic", "Shiny", "Gold", "Silver", "Rainbow", "Diamond", "Aurora", "Lunar", "Starlight", "Blossom"}
local currentRarityIndex = 1

local RarityBtn = Instance.new("TextButton")
RarityBtn.Parent = MainFrame
