-- ปุ่มเลือกความหายาก (Rarity Filter Button)
local rarities = {"All (ทั้งหมด)", "Shiny", "Gold", "Silver", "Rainbow", "Diamond", "Aurora", "Lunar", "Starlight", "Blossom"}[span_1](start_span)[span_1](end_span)
