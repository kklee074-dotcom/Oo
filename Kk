-- ==========================================
-- สคริปต์ KPOP Hub (Instant Steal + Auto Money + Auto Best Card)
-- ==========================================

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local VirtualUser = game:GetService("VirtualUser")
local CoreGui = game:GetService("CoreGui")

local player = Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()

local autoStealActive = false
local autoCollectMoneyActive = false
local autoBestCardActive = false

player.Idled:Connect(function()
    VirtualUser:CaptureController()
    VirtualUser:ClickButton2(Vector2.new())
end)

RunService.Stepped:Connect(function()
    if autoStealActive and character then
        for _, part in pairs(character:GetDescendants()) do
            if part:IsA("BasePart") and part.CanCollide then
                part.CanCollide = false
            end
        end
    end
end)

local function interact(obj)
    if obj:IsA("ProximityPrompt") then
        fireproximityprompt(obj)
    elseif obj:IsA("ClickDetector") then
        fireclickdetector(obj)
    end
end

-- ระบบเก็บเงินออโต้
local function doAutoCollectMoney()
    while autoCollectMoneyActive do
        character = player.Character or player.CharacterAdded:Wait()
        local root = character:FindFirstChild("HumanoidRootPart")
        
        if root and firetouchinterest then
            for _, obj in pairs(workspace:GetDescendants()) do
                if obj:IsA("BasePart") and (obj.Name == "AutoCollect" or obj.Name == "Touch") then
                    if obj:IsDescendantOf(workspace:FindFirstChild("Plot_" .. player.Name) or workspace) then
                        firetouchinterest(root, obj, 0)
                        task.wait(0.05)
                        firetouchinterest(root, obj, 1)
                    end
                end
            end
        end
        task.wait(2)
    end
end

-- ระบบ Instant Steal แบบกวาดเรียบ
local function doAutoSteal()
    while autoStealActive do
        character = player.Character or player.CharacterAdded:Wait()
        local root = character:FindFirstChild("HumanoidRootPart")
        
        if root then
            for _, obj in pairs(workspace:GetDescendants()) do
                if not autoStealActive then break end
                
                if obj:IsA("ProximityPrompt") or obj:IsA("ClickDetector") then
                    local parentPart = obj.Parent
                    if parentPart and (parentPart:IsA("BasePart") or parentPart:IsA("Model")) then
                        
                        local isInOtherPlot = false
                        local ancestor = parentPart.Parent
                        while ancestor and ancestor ~= workspace do
                            if string.find(ancestor.Name, "Plot_") and ancestor.Name ~= ("Plot_" .. player.Name) then
                                isInOtherPlot = true
                                break
                            end
                            ancestor = ancestor.Parent
                        end
                        
                        if not isInOtherPlot then
                            local originalCFrame = root.CFrame
                            local targetCF = parentPart:IsA("Model") and parentPart:GetPivot() or parentPart.CFrame
                            
                            root.CFrame = targetCF + Vector3.new(0, 2, 0)
                            task.wait(0.05)
                            
                            for i = 1, 4 do
                                interact(obj)
                                task.wait(0.05)
                            end
                            
                            root.CFrame = originalCFrame
                            task.wait(0.1)
                        end
                    end
                end
            end
        end
        task.wait(0.3)
    end
end

-- ระบบจำลองการเลือกและวางการ์ดที่ดีที่สุดลงฐาน
local function doAutoBestCard()
    while autoBestCardActive do
        pcall(function()
            -- ค้นหาจุดสล็อตหรือแท่นวางการ์ดในฐานของผู้เล่น
            local myPlot = workspace:FindFirstChild("Plot_" .. player.Name)
            if myPlot then
                for _, obj in pairs(myPlot:GetDescendants()) do
                    if obj:IsA("ProximityPrompt") and (string.find(string.lower(obj.Name), "card") or string.find(string.lower(obj.Name), "place") or string.find(string.lower(obj.Parent.Name), "slot")) then
                        local originalCFrame = character.HumanoidRootPart.CFrame
                        character.HumanoidRootPart.CFrame = obj.Parent:IsA("BasePart") and obj.Parent.CFrame or obj.Parent:GetPivot()
                        task.wait(0.1)
                        fireproximityprompt(obj)
                        task.wait(0.1)
                        character.HumanoidRootPart.CFrame = originalCFrame
                    end
                end
            end
        end)
        task.wait(5)
    end
end

