-- ปุ่มวาร์ปกลับแปลงของฉัน
local BaseBtn = Instance.new("TextButton")
BaseBtn.Parent = MainFrame
BaseBtn.BackgroundColor3 = Color3.fromRGB(155, 89, 182)
BaseBtn.Position = UDim2.new(0.1, 0, 0.28, 0)
BaseBtn.Size = UDim2.new(0.8, 0, 0, 35)
BaseBtn.Font = Enum.Font.SourceSansBold
BaseBtn.Text = "วาร์ปกลับแปลงของฉัน"
BaseBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
BaseBtn.TextSize = 13
Instance.new("UICorner", BaseBtn).CornerRadius = UDim.new(0, 6)

BaseBtn.MouseButton1Click:Connect(function()
    pcall(function()
        for _, plot in pairs(Workspace.Plots:GetChildren()) do
            if plot:FindFirstChild("Base") and plot:GetAttribute("PlotOwner") == LocalPlayer.UserId then
                LocalPlayer.Character.HumanoidRootPart.CFrame = plot.Base.CFrame + Vector3.new(0, 5, 0)
                break
            end
        end
    end)
end)

-- ป้ายแสดงสถานะ
local StatusLabel = Instance.new("TextLabel")
StatusLabel.Parent = MainFrame
StatusLabel.BackgroundTransparency = 1
StatusLabel.Position = UDim2.new(0.1, 0, 0.6, 0)
StatusLabel.Size = UDim2.new(0.8, 0, 0, 40)
StatusLabel.Font = Enum.Font.SourceSansBold
StatusLabel.Text = "กดปุ่มวงกลมซ้ายจอเพื่อเริ่ม (มีระบบกันเลือดลด)"
StatusLabel.TextColor3 = Color3.fromRGB(180, 180, 180)
StatusLabel.TextSize, StatusLabel.TextWrapped = 12, true

-- ระบบขโมยการ์ดทั้งหมด พร้อมระบบป้องกันเลือดลด (Anti-Damage / Health Lock)
local isStealingRunning = false
CircleToggleBtn.MouseButton1Click:Connect(function()
    isStealingRunning = not isStealingRunning
    if isStealingRunning then
        CircleToggleBtn.BackgroundColor3 = Color3.fromRGB(46, 204, 113)
        StatusLabel.Text = "สถานะ: กำลังขโมยการ์ด (ปลอดภัย)"
        StatusLabel.TextColor3 = Color3.fromRGB(46, 204, 113)
        
        task.spawn(function()
            while isStealingRunning do
                pcall(function()
                    -- ล็อคเลือดให้เต็มตลอดเวลาขณะรันระบบป้องกันตัวละครตาย
                    local humanoid = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid")
                    if humanoid then
                        humanoid.Health = humanoid.MaxHealth
                    end

                    local basePos = nil
                    for _, plot in pairs(Workspace.Plots:GetChildren()) do
                        if plot:FindFirstChild("Base") and plot:GetAttribute("PlotOwner") == LocalPlayer.UserId then
                            basePos = plot.Base.CFrame + Vector3.new(0, 5, 0)
                            break
                        end
                    end
                    
                    local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                    if hrp and basePos then
                        local collected = false
                        
                        for _, obj in pairs(Workspace:GetDescendants()) do
                            if not isStealingRunning then break end
                            if obj:IsA("ProximityPrompt") then
                                local actionText = string.lower(obj.ActionText or "")
                                local objectText = string.lower(obj.ObjectText or "")
                                local parentName = string.lower(obj.Parent and obj.Parent.Name or "")
                                
                                local isRobuxPrompt = (actionText:find("buy") or actionText:find("pass") or actionText:find("robux") or 
                                                       objectText:find("buy") or objectText:find("pass") or objectText:find("robux") or
                                                       parentName:find("pass") or parentName:find("gamepass"))
                                
                                if not isRobuxPrompt then
                                    local targetPart = obj.Parent
                                    if targetPart and targetPart:IsA("BasePart") then
                                        -- ยกความสูงขึ้นเป็น Vector3.new(0, 4, 0) เพื่อไม่ให้ตัวละครจมลงไปในพื้นจนเลือดลด
                                        hrp.CFrame = targetPart.CFrame + Vector3.new(0, 4, 0)
                                        task.wait(0.2)
                                        fireproximityprompt(obj)
                                        task.wait(0.2)
                                        hrp.CFrame = basePos
                                        collected = true
                                        task.wait(0.5)
                                        break
                                    end
                                end
                            end
                        end
                        
                        if not collected then
                            task.wait(1)
                        end
                    end
                end)
                task.wait(0.3)
            end
        end)
    else
        CircleToggleBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
        StatusLabel.Text = "สถานะ: ปิดการทำงาน"
        StatusLabel.TextColor3 = Color3.fromRGB(180, 180, 180)
    end
end)
