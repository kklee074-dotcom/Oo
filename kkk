-------------------------------------------------------------
createActionButton(TeleportPage, "วาร์ปกลับแปลงที่ดินของฉัน", 0.05, Color3.fromRGB(52, 152, 219), function()
    pcall(function()
        for _, plot in pairs(Workspace.Plots:GetChildren()) do
            if plot:FindFirstChild("Base") then
                if plot:GetAttribute("PlotOwner") == LocalPlayer.UserId then
                    LocalPlayer.Character.HumanoidRootPart.CFrame = plot.Base.CFrame + Vector3.new(0, 5, 0)
                    break
                end
            end
        end
    end)
end)

-- ฟังก์ชันใหม่: วาร์ปไปหยิบทีละใบ แล้วกลับฐานทันทีวนไปเรื่อยๆ
createActionButton(TeleportPage, "เก็บการ์ดทีละใบ & กลับฐานทันที", 0.25, Color3.fromRGB(46, 204, 113), function()
    task.spawn(function()
        pcall(function()
            local basePos = nil
            for _, plot in pairs(Workspace.Plots:GetChildren()) do
                if plot:FindFirstChild("Base") and plot:GetAttribute("PlotOwner") == LocalPlayer.UserId then
                    basePos = plot.Base.CFrame + Vector3.new(0, 5, 0)
                    break
                end
            end
            
            local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if not hrp or not basePos then return end

            for _, obj in pairs(Workspace:GetDescendants()) do
                if obj:IsA("ProximityPrompt") then
                    local parentPart = obj.Parent
                    if parentPart and parentPart:IsA("BasePart") then
                        -- 1. วาร์ปไปหาการ์ดใบแรก
                        hrp.CFrame = parentPart.CFrame + Vector3.new(0, 3, 0)
                        task.wait(0.2)
                        
                        -- 2. กดเก็บ
                        fireproximityprompt(obj)
                        task.wait(0.2)
                        
                        -- 3. วาร์ปกลับฐานทันทีก่อนไปใบถัดไป
                        hrp.CFrame = basePos
                        task.wait(0.4)
                    end
                end
            end
        end)
    end)
end)

createActionButton(TeleportPage, "พุ่งทะลุข้ามประตู/ด่าน", 0.45, Color3.fromRGB(231, 76, 60), function()
