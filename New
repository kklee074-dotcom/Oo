-- ฟังก์ชันสร้างปุ่มเมนูข้างใน
local function createButton(posY, text, color)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, 220, 0, 40)
    btn.Position = UDim2.new(0.5, -110, 0, posY)
    btn.BackgroundColor3 = color
    btn.Text = text
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.TextSize = 15
    btn.Font = Enum.Font.SourceSansBold
    btn.Parent = MainFrame
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 8)
    corner.Parent = btn
    
    return btn
end

-- ปุ่มฟังก์ชันภายใน
local BtnSteal = createButton(55, "📦 ขโมยการ์ด & กลับฐานทันที", Color3.fromRGB(0, 170, 127))
local BtnMoney = createButton(110, "💰 ดูดเงินออโต้: ปิด", Color3.fromRGB(200, 80, 80))

-- --- ระบบควบคุมการเปิด-ปิด UI ---
ToggleBtn.MouseButton1Click:Connect(function()
    MainFrame.Visible = not MainFrame.Visible
    if MainFrame.Visible then
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 70)
    else
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 127) -- เปลี่ยนสีปุ่มลอยเมื่อซ่อนเมนู เพื่อให้รู้ว่าปิดอยู่
    end
end)

-- --- ระบบการทำงานภายใน (Logic) ---
local function getMyBase()
    local basesFolder = Workspace:FindFirstChild("Bases") or Workspace:FindFirstChild("Plots") or Workspace:FindFirstChild("holdbases")
    if basesFolder then
        for _, base in ipairs(basesFolder:GetChildren()) do
            if base:FindFirstChild("Owner") and base.Owner.Value == LocalPlayer then
                return base
            end
        end
    end
    return nil
end

-- กดปุ่มขโมยการ์ด
BtnSteal.MouseButton1Click:Connect(function()
    task.spawn(function()
        BtnSteal.Text = "กำลังขโมย..."
        local character = LocalPlayer.Character
        if not character or not character:FindFirstChild("HumanoidRootPart") then return end
        local hrp = character.HumanoidRootPart
        
        local cardsFolder = Workspace:FindFirstChild("Cards") or Workspace:FindFirstChild("Items")
        local myBase = getMyBase()
        
        if cardsFolder and myBase then
            local dropOffPoint = myBase:FindFirstChild("Core") or myBase:FindFirstChild("DropOff") or myBase:FindFirstChildWhichIsA("BasePart")
            for _, card in ipairs(cardsFolder:GetChildren()) do
                local cardPart = card:IsA("BasePart") and card or card.PrimaryPart or card:FindFirstChildWhichIsA("BasePart")
                if cardPart and dropOffPoint then
                    hrp.CFrame = cardPart.CFrame + Vector3.new(0, 3, 0)
                    task.wait(0.1)
                    hrp.CFrame = dropOffPoint.CFrame + Vector3.new(0, 3, 0)
                    task.wait(0.1)
                end
            end
        end
        BtnSteal.Text = "📦 ขโมยการ์ด & กลับฐานทันที"
    end)
end)

-- ระบบดูดเงินออโต้
local autoMoneyActive = false
BtnMoney.MouseButton1Click:Connect(function()
    autoMoneyActive = not autoMoneyActive
    if autoMoneyActive then
        BtnMoney.Text = "💰 ดูดเงินออโต้: เปิด"
        BtnMoney.BackgroundColor3 = Color3.fromRGB(46, 204, 113)
        
        task.spawn(function()
            while autoMoneyActive do
                local character = LocalPlayer.Character
                if character and character:FindFirstChild("HumanoidRootPart") then
                    local hrp = character.HumanoidRootPart
                    local moneyFolder = Workspace:FindFirstChild("Money") or Workspace:FindFirstChild("Cash") or Workspace:FindFirstChild("Coins") or Workspace:FindFirstChild("Drops")
                    
                    if moneyFolder then
                        for _, item in ipairs(moneyFolder:GetChildren()) do
                            if not autoMoneyActive then break end
                            local itemPart = item:IsA("BasePart") and item or item.PrimaryPart or item:FindFirstChildWhichIsA("BasePart")
                            if itemPart then
                                local currentPos = hrp.CFrame
                                hrp.CFrame = itemPart.CFrame
                                task.wait(0.03)
                                hrp.CFrame = currentPos
                            end
                        end
                    end
                end
                task.wait(1)
            end
        end)
    else
        BtnMoney.Text = "💰 ดูดเงินออโต้: ปิด"
        BtnMoney.BackgroundColor3 = Color3.fromRGB(200, 80, 80)
    end
end)

print("โหลด UI แบบมีปุ่มปิด/เปิดสำเร็จ!")
