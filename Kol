                            for _, desc in pairs(plot:GetDescendants()) do
                                if desc:IsA("ProximityPrompt") then
                                    local actionText = string.lower(desc.ActionText or "")
                                    local objectText = string.lower(desc.ObjectText or "")
                                    local parentName = string.lower(desc.Parent.Name or "")
                                    
                                    if not (actionText:find("buy") or actionText:find("pass") or actionText:find("robux") or 
                                            objectText:find("buy") or objectText:find("pass") or objectText:find("robux") or
                                            parentName:find("pass") or parentName:find("gamepass")) then
                                        fireproximityprompt(desc)
                                    end
                                end
                            end
                        end
                    end
                end)
                task.wait(1)
            end
        end)
    end
end)

createActionButton(FarmPage, "วาร์ปหาอีเวนต์สภาพอากาศ", 0.32, Color3.fromRGB(241, 196, 15), function()
    task.spawn(function()
        pcall(function()
            local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if not hrp then return end
            
            local foundEvent = false
            for _, obj in pairs(Workspace:GetDescendants()) do
                if obj:IsA("ProximityPrompt") or obj:IsA("BasePart") then
                    local nameLower = obj.Name:lower()
                    if nameLower:find("aurora") or nameLower:find("star") or nameLower:find("moon") or nameLower:find("sakura") or nameLower:find("weather") then
                        local targetPart = obj:IsA("ProximityPrompt") and obj.Parent or obj
                        if targetPart and targetPart:IsA("BasePart") then
                            hrp.CFrame = targetPart.CFrame + Vector3.new(0, 3, 0)
                            if obj:IsA("ProximityPrompt") then
                                fireproximityprompt(obj)
                            end
                            foundEvent = true
                            break
                        end
                    end
                end
            end
            
            if not foundEvent then
                print("[Hub] ไม่พบจุดอีเวนต์สภาพอากาศในขณะนี้")
            end
        end)
    end
end)

