                            local collected = false
                            
                            for _, obj in pairs(Workspace:GetDescendants()) do
                                if not isStealingRunning then break end
                                if obj:IsA("ProximityPrompt") then
                                    local parentModel = obj.Parent and obj.Parent.Parent
                                    local match = true
                                    
                                    if not targetFilter:find("All") then
