    -- ฟาร์มหลัก: Auto Prompt สล็อต
    local isAutoRunning = false
    createBtn(FarmPage, "เปิด Auto Prompt (สล็อต)", 0.05, Color3.fromRGB(46, 204, 113), function()
        isAutoRunning = not isAutoRunning
        if isAutoRunning then
            task.spawn(function()
                while isAutoRunning do
                    pcall(function()
                        for _, plot in pairs(Workspace.Plots:GetChildren()) do
                            for _, expansion in pairs(plot:GetChildren()) do
                                if expansion.Name:match("Expansion") then
                                    for _, slot in pairs(expansion:GetChildren()) do
                                        if slot:FindFirstChild("PromptAttachment") then
                                            local prompt = slot.PromptAttachment:FindFirstChild("ProximityPrompt")
                                            if prompt and prompt.Enabled then
                                                fireproximityprompt(prompt)
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end)
                    task.wait(1.5)
                end
            end)
        end
    end)

    -- Auto เก็บเงินแบบปลอดภัย (กรอง Robux)
    local isAutoCashRunning = false
    createBtn(FarmPage, "เปิด Auto เก็บเงิน (ปลอดภัย)", 0.22, Color3.fromRGB(52, 152, 219), function()
        isAutoCashRunning = not isAutoCashRunning
        if isAutoCashRunning then
            task.spawn(function()
                while isAutoCashRunning do
                    pcall(function()
                        for _, plot in pairs(Workspace.Plots:GetChildren()) do
                            if plot:GetAttribute("PlotOwner") == LocalPlayer.UserId then
                                for _, desc in pairs(plot:GetDescendants()) do
                                    if desc:IsA("ProximityPrompt") then
                                        local actionText = string.lower(desc.ActionText or "")
                                        local objectText = string.lower(desc.ObjectText or "")
                                        local parentName = string.lower(desc.Parent.Name or "")
                                        if not (actionText:find("buy") or actionText:find("pass") or actionText:find("robux") or 
                                                objectText:find("buy") or objectText:find("pass") or objectText:find("robux") or
                                                parentName:find("pass") or parentName:find("gamepass")) then
                                            fireproximityprompt(desc)
                                        end
                                    end
                                end
                            end
                        end
                    end)
                    task.wait(1)
                end
            end)
        end
    end)

