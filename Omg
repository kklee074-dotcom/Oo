        pcall(function()
            for _, plot in pairs(Workspace.Plots:GetChildren()) do
                if plot:FindFirstChild("Base") and plot:GetAttribute("PlotOwner") == LocalPlayer.UserId then
                    LocalPlayer.Character.HumanoidRootPart.CFrame = plot.Base.CFrame + Vector3.new(0, 5, 0)
                    break
                end
            end
        end)
    end)

    -- เร่งความเร็ว
    createBtn(FarmPage, "เร่งความเร็ว (Speed: 50)", 0.56, Color3.fromRGB(230, 126, 34), function()
        pcall(function()
            if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
                LocalPlayer.Character.Humanoid.WalkSpeed = 50
