end

-- ระบบเก็บเงินออโต้ (เฉพาะในบ้านตัวเอง)
local function doAutoCollectMoney()
    while autoCollectMoneyActive do
        character = player.Character or player.CharacterAdded:Wait()
        local root = character:FindFirstChild("HumanoidRootPart")
        
        if root and firetouchinterest then
            for _, obj in pairs(workspace:GetDescendants()) do
                if obj:IsA("BasePart") and (obj.Name == "AutoCollect" or obj.Name == "Touch") then
                    if obj:IsDescendantOf(workspace:FindFirstChild("Plot_" .. player.Name) or workspace) then
                        firetouchinterest(root, obj, 0)
                        task.wait(0.05)
                        firetouchinterest(root, obj, 1)
                    end
                end
            end
        end
        task.wait(2)
    end
end

-- ระบบปลดล็อคฐานออโต้ (เฉพาะในบ้านตัวเอง)
local function doAutoUnlockPlot()
    while autoUnlockPlotActive do
        pcall(function()
            character = player.Character or player.CharacterAdded:Wait()
            local root = character:FindFirstChild("HumanoidRootPart")
            local myPlot = workspace:FindFirstChild("Plot_" .. player.Name)
            
            local leaderstats = player:FindFirstChild("leaderstats")
            local playerMoney = 0
            if leaderstats then
                local cash = leaderstats:FindFirstChild("Cash") or leaderstats:FindFirstChild("Money") or leaderstats:FindFirstChild("Coins")
                if cash then playerMoney = cash.Value end
            end
            
            if root and myPlot and firetouchinterest then
                for _, obj in pairs(myPlot:GetDescendants()) do
                    if not autoUnlockPlotActive then break end
                    
                    if obj:IsA("BasePart") and (string.find(string.lower(obj.Name), "button") or string.find(string.lower(obj.Name), "unlock") or string.find(string.lower(obj.Name), "buy") or obj.Name == "Touch") then
                        local cost = obj:GetAttribute("Cost") or obj:GetAttribute("Price")
                        if not cost and obj.Parent then
                            cost = obj.Parent:GetAttribute("Cost") or obj.Parent:GetAttribute("Price")
                        end
                        
                        if cost and playerMoney < cost then
                            continue
                        end
                        
                        local originalCFrame = root.CFrame
                        root.CFrame = obj.CFrame + Vector3.new(0, 2, 0)
                        task.wait(0.05)
                        firetouchinterest(root, obj, 0)
                        task.wait(0.05)
                        firetouchinterest(root, obj, 1)
                        task.wait(0.1)
                        root.CFrame = originalCFrame
                        task.wait(0.5)
                    end
                end
            end
        end)
        task.wait(3)
    end
end

-- ระบบ Instant Steal (ตัดบ้านตัวเองออก 100% ป้องกันการหยิบของในบ้าน)
local function doAutoSteal()
    while autoStealActive do
        character = player.Character or player.CharacterAdded:Wait()
        local root = character:FindFirstChild("HumanoidRootPart")
        
        if root then
            for _, obj in pairs(workspace:GetDescendants()) do
                if not autoStealActive then break end
                
                if obj:IsA("ProximityPrompt") or obj:IsA("ClickDetector") then
                    local parentPart = obj.Parent
                    if parentPart and (parentPart:IsA("BasePart") or parentPart:IsA("Model")) then
                        
                        -- เช็กอย่างเข้มงวด: ห้ามอยู่ภายใต้ Plot ของตัวเองเด็ดขาด
                        local isMyPlotItem = false
                        local ancestor = parentPart
                        while ancestor and ancestor ~= workspace do
                            if ancestor.Name == ("Plot_" .. player.Name) then
                                isMyPlotItem = true
                                break
                            end
                            ancestor = ancestor.Parent
                        end
                        
                        -- ถ้าไม่ใช่ของในบ้านตัวเอง ให้ดำเนินการเช็กฟิลเตอร์และขโมย
                        if not isMyPlotItem then
                            local hasAnyFilter = false
                            for _, v in pairs(selectedFilters) do 
                                if v then hasAnyFilter = true break end 
                            end
                            
                            local matchFilter = false
                            if not hasAnyFilter then
                                matchFilter = true
                            else
                                local searchTarget = parentPart.Name
                                if parentPart.Parent then searchTarget = searchTarget .. " " .. parentPart.Parent.Name end
                                
                                for _, descendant in pairs(parentPart:GetDescendants()) do
                                    if descendant:IsA("TextLabel") or descendant:IsA("StringValue") then
                                        searchTarget = searchTarget .. " " .. tostring(descendant.Text or descendant.Value)
                                    end
                                end
                                
                                for filterName, isSelected in pairs(selectedFilters) do
                                    if isSelected then
                                        if string.find(string.lower(searchTarget), string.lower(filterName)) then
                                            matchFilter = true
                                            break
                                        end
                                    end
                                end
                            end
                            
                            if matchFilter then
                                local originalCFrame = root.CFrame
                                local targetCF = parentPart:IsA("Model") and parentPart:GetPivot() or parentPart.CFrame
                                
                                root.CFrame = targetCF + Vector3.new(0, 2, 0)
                                task.wait(0.05)
                                
                                for i = 1, 4 do
                                    interact(obj)
                                    task.wait(0.05)
                                end
                                
                                root.CFrame = originalCFrame
                                task.wait(0.1)
                            end
                        end
                    end
                end
            end
        end
        task.wait(0.3)
    end
end

