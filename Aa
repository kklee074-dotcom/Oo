local function createToggleRow(parent, text, callback)
    local frame = Instance.new("Frame", parent)
    frame.Size = UDim2.new(1, -6, 0, 36)
    frame.BackgroundColor3 = Color3.fromRGB(28, 28, 35)
    Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 6)
    
    local lbl = Instance.new("TextLabel", frame)
    lbl.Size = UDim2.new(1, -55, 1, 0)
    lbl.Position = UDim2.new(0, 10, 0, 0)
    lbl.BackgroundTransparency = 1
    lbl.Text = text
    lbl.TextColor3 = Color3.fromRGB(220, 220, 230)
    lbl.Font = Enum.Font.GothamMedium
    lbl.TextSize = 11
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    
    local tBtn = Instance.new("TextButton", frame)
    tBtn.Size = UDim2.new(0, 42, 0, 22)
    tBtn.Position = UDim2.new(1, -48, 0.5, -11)
    tBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 60)
    tBtn.Text = "OFF"
    tBtn.TextColor3 = Color3.fromRGB(180, 180, 180)
    tBtn.Font = Enum.Font.GothamBold
    tBtn.TextSize = 9
    Instance.new("UICorner", tBtn).CornerRadius = UDim.new(1, 0)
    
    local active = false
    tBtn.MouseButton1Click:Connect(function()
        active = not active
        if active then
            tBtn.BackgroundColor3 = Color3.fromRGB(60, 200, 90)
            tBtn.TextColor3 = Color3.fromRGB(25, 25, 30)
            tBtn.Text = "ON"
        else
            tBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 60)
            tBtn.TextColor3 = Color3.fromRGB(180, 180, 180)
            tBtn.Text = "OFF"
        end
        callback(active)
    end)
end

